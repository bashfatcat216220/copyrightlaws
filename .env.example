# Copyright Corpus — copy to .env (gitignored). UK + EU + eCFR + Federal Register are keyless.
# US federal bill text (GovInfo) and pipeline connectors need free api.data.gov keys.

GOVINFO_API_KEY=          # api.data.gov — GovInfo bulk USLM (17 U.S.C. text)
CONGRESS_GOV_API_KEY=     # api.congress.gov — copyright-tagged bills (pipeline)
LEGISCAN_API_KEY=         # legiscan.com — US-state copyright-adjacent bills

ANTHROPIC_API_KEY=        # claude-opus-4-8 — matrix drafting, summaries, redline notes

# Deployment: point the DB at a persistent disk (mirrors ai-law-portal's PORTAL_DB_PATH).
# CORPUS_DB_PATH=/var/data/corpus.db
